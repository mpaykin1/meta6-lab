45 \u043e\u0431\u043b\u0430\u043a\u043e\u0432, \u0434\u044b\u043c\u0430, \u043e\u0433\u043d\u044f, \u043f\u043e\u0433\u043e\u0434\u044b \u0440\u0430\u0437\u0440\u0435\u0448\u0451\u043d motion FX \u0438 RIFE (\u0441 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c \u043e\u0442 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 \u0441\u043b\u043e\u0435\u043c), \u043d\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0438 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044e\u0442 \u0432 \u0434\u0435\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438. \u041f\u0435\u0440\u0435\u0434 \u0432\u044b\u0434\u0430\u0447\u0435\u0439 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c scripts/character_frame_gate.py manifest.json --renderer render.py [--preview], \u0437\u0430\u0442\u0435\u043c scripts/smooth_motion_gate.py final.gif, \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0442\u044c \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u043a\u0430\u0434\u0440\u044b, \u043e\u0431\u0443\u0432\u044c, \u0445\u0432\u043e\u0441\u0442\u044b, \u043b\u0438\u0446\u0430, \u0430\u043b\u044c\u0444\u0430-\u043a\u0430\u043d\u0430\u043b, \u0446\u0438\u043a\u043b. \u041d\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043d\u0435\u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c.\n\u041f\u0420\u0415\u0416\u041d\u0418\u0415 \u0418\u041d\u0422\u0415\u0413\u0420\u0410\u0426\u0418\u0418 \u0421\u041e\u0425\u0420\u0410\u041d\u0418\u0422\u042c: \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0435 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0435 GIF/PNG \u2192 \u043e\u043f\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e rembg \u0434\u043b\u044f \u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438, RIFE \u0422\u041e\u041b\u042c\u041a\u041e \u0414\u041b\u042f \u041d\u0415-PERSONA \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438
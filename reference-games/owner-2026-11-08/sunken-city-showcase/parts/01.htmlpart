<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Затонувший город</title>
<meta name="description" content="Ассет-пак «Затонувший город»: живой подводный город из 76 воксельных моделей и каталог — 2D, 2.5D, 3D, тайлы 16×16 и анимации.">
<meta name="theme-color" content="#040a16">
<meta property="og:title" content="Затонувший город">
<meta property="og:description" content="Ассет-пак «Затонувший город»: живой подводный город из 76 воксельных моделей и каталог — 2D, 2.5D, 3D, тайлы 16×16 и анимации.">
<link rel="icon" href="data:image/svg+xml;base64,">
<style>
@font-face{font-family:'Tiny5';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'Tiny5';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Golos Text';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'Golos Text';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Golos Text';font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'Golos Text';font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Golos Text';font-style:normal;font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'Golos Text';font-style:normal;font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
html,body{height:100%}body{margin:0}img{max-width:100%}[hidden]{display:none!important}button{-webkit-appearance:none;appearance:none}

/* Layout: the living city fills the screen; dark-glass panels float over it — a dock at the bottom,
   the catalogue as a right-hand drawer (a full sheet on phones), the 3D inspector as a bottom bar.
   One visual world (the abyss at night), so a single dark palette. */
:root {
  --abyss: #040a16;
  --deep: #0a1830;
  --glass: rgba(5, 14, 30, 0.84);
  --glass-hi: rgba(14, 34, 62, 0.92);
  --ink: #d9e8f1;
  --mute: #86a0b6;
  --line: rgba(125, 227, 238, 0.16);
  --teal: #3fe0d8;
  --amber: #ffc25a;
  --violet: #b07cff;
  --danger: #ff5468;
  --f-disp: "Tiny5", "Courier New", monospace;
  --f-body: "Golos Text", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --f-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  --r: 10px;
  color-scheme: dark;
  font-synthesis: none;
}
html, body { height: 100%; }
body {
  background: var(--abyss); color: var(--ink); font-family: var(--f-body); font-size: 15px; line-height: 1.45;
  overflow: hidden; overscroll-behavior: none; -webkit-tap-highlight-color: transparent;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
}
canvas#gl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; outline: none; }
button { font: inherit; color: inherit; cursor: pointer; }
button:focus-visible, [tabindex]:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
.btn {
  border: 1px solid var(--line); background: var(--glass); color: var(--ink); border-radius: 999px;
  padding: 10px 18px; font-weight: 500; letter-spacing: .01em; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  transition: background .2s, border-color .2s, transform .15s;
}
.btn:hover { border-color: rgba(125, 227, 238, .45); background: var(--glass-hi); }
.btn:active { transform: scale(.97); }
.btn.primary { background: linear-gradient(180deg, rgba(63, 224, 216, .26), rgba(63, 224, 216, .1)); border-color: rgba(63, 224, 216, .55); }
.btn .dim { color: var(--mute); font-family: var(--f-mono); font-size: 12px; margin-left: 6px; }

/* loader */
.loader { position: fixed; inset: 0; z-index: 50; display: grid; place-content: center; gap: 18px; text-align: center;
  background: radial-gradient(120% 90% at 50% 20%, #0b2140 0%, #040a16 60%); transition: opacity 1.2s ease; }
.loader.gone { opacity: 0; pointer-events: none; }
.loader h2 { font-family: var(--f-disp); font-weight: 400; font-size: clamp(30px, 7vw, 56px); margin: 0; letter-spacing: .02em;
  color: #e9fbff; text-shadow: 0 0 24px rgba(63, 224, 216, .45), 0 3px 0 #0a1830; }
.ld-bar { width: min(320px, 70vw); height: 6px; margin: 0 auto; border-radius: 3px; background: rgba(125, 227, 238, .12); overflow: hidden; }
.ld-bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--teal), var(--amber)); transition: width .3s; }
#ldText { color: var(--mute); font-size: 13px; font-family: var(--f-mono); }

/* header over the city */
.hud { position: fixed; z-index: 5; top: calc(env(safe-area-inset-top, 0px) + 18px); left: max(18px, env(safe-area-inset-left, 0px));
  max-width: min(560px, calc(100vw - 36px)); pointer-events: none; transition: opacity .6s; }
.hud .eyebrow { margin: 0 0 4px; font-family: var(--f-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--teal); opacity: .85; }
.hud h1 { margin: 0; font-family: var(--f-disp); font-weight: 400; font-size: clamp(32px, 6vw, 60px); line-height: 1; letter-spacing: .02em;
  color: #eafcff; text-shadow: 0 0 28px rgba(63, 224, 216, .35), 0 3px 0 #061226; text-wrap: balance; }
.hud .counts { margin: 10px 0 0; color: #b9cfdc; font-size: 14px; max-width: 46ch; text-shadow: 0 1px 2px #000; }
.hud .counts b { color: var(--amber); font-weight: 600; }
.hud.faded { opacity: 0; }

.dock { position: fixed; z-index: 6; left: 0; right: 0; bottom: 0; display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-start;
  padding: 14px max(18px, env(safe-area-inset-left, 0px)) calc(env(safe-area-inset-bottom, 0px) + 18px) max(18px, env(safe-area-inset-left, 0px)); pointer-events: none; }
.dock > * { pointer-events: auto; }

/* tapped object card */
.pick { position: fixed; z-index: 7; left: 50%; transform: translateX(-50%); bottom: calc(env(safe-area-inset-bottom, 0px) + 84px);
  display: flex; align-items: center; gap: 12px; padding: 10px 12px 10px 16px; border-radius: 14px; background: var(--glass);
  border: 1px solid var(--line); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); max-width: calc(100vw - 32px); }
.pick b { font-family: var(--f-disp); font-weight: 400; font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pick span { color: var(--mute); font-size: 12px; font-family: var(--f-mono); white-space: nowrap; }
.pick button { flex: none; border: 1px solid rgba(63, 224, 216, .5); background: rgba(63, 224, 216, .14); border-radius: 999px; padding: 7px 12px; font-size: 13px; }

/* pilot */
#pilot { position: fixed; inset: 0; z-index: 6; pointer-events: none; }
#pilot .row { position: absolute; right: max(18px, env(safe-area-inset-right, 0px)); bottom: calc(env(safe-area-inset-bottom, 0px) + 20px);
  display: flex; gap: 10px; align-items: flex-end; pointer-events: auto; }
#pilot .col { display: flex; flex-direction: column; gap: 10px; }
.round { width: 58px; height: 58px; border-radius: 50%; border: 1px solid var(--line); background: var(--glass); font-size: 20px; display: grid; place-items: center;
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); touch-action: none; user-select: none; -webkit-user-select: none; }
.round.big { width: 76px; height: 76px; font-family: var(--f-disp); font-size: 15px; border-color: rgba(63, 224, 216, .6); background: rgba(63, 224, 216, .16); }
.round.on { background: rgba(63, 224, 216, .35); }
#pExit { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 16px); right: max(18px, env(safe-area-inset-right, 0px)); pointer-events: auto; }
#pHint { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 22px); left: max(18px, env(safe-area-inset-left, 0px)); right: 140px;
  color: #b9cfdc; font-size: 13px; text-shadow: 0 1px 2px #000; margin: 0; }
#joy { position: absolute; width: 120px; height: 120px; margin: -60px 0 0 -60px; border-radius: 50%; border: 1px solid rgba(125, 227, 238, .3);
  background: radial-gradient(circle, rgba(63, 224, 216, .12), rgba(5, 14, 30, .25) 70%); pointer-events: none; opacity: 0; transition: opacity .2s; }
#joy i { position: absolute; left: 50%; top: 50%; width: 46px; height: 46px; margin: -23px; border-radius: 50%; background: rgba(63, 224, 216, .45); border: 1px solid rgba(233, 252, 255, .6); }
#danger { position: absolute; left: 50%; top: 30%; transform: translateX(-50%); font-family: var(--f-disp); color: var(--danger);
  font-size: 20px; letter-spacing: .04em; text-shadow: 0 0 14px rgba(255, 84, 104, .7); opacity: 0; transition: opacity .3s; margin: 0; }

/* catalogue drawer */
.cat { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; width: min(600px, 100vw); display: flex; flex-direction: column;
  background: linear-gradient(180deg, rgba(6, 16, 34, .95), rgba(4, 10, 22, .97)); border-left: 1px solid var(--line);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); padding-right: env(safe-area-inset-right, 0px);
  transform: translateX(0); transition: transform .45s cubic-bezier(.2, .8, .2, 1); }
.cat.off { transform: translateX(104%); }
.cat header { display: flex; align-items: center; gap: 12px; padding: 16px 16px 6px 20px; }
.cat header h2 { margin: 0; font-family: var(--f-disp); font-weight: 400; font-size: 26px; flex: 1; letter-spacing: .01em; }
.x { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: transparent; font-size: 18px; display: grid; place-items: center; }
.tabs, .chips { display: flex; gap: 6px; overflow-x: auto; padding: 8px 16px 8px 20px; scrollbar-width: none; flex: none; }
.tabs::-webkit-scrollbar, .chips::-webkit-scrollbar { display: none; }
.tab { flex: none; border: 1px solid transparent; background: transparent; padding: 7px 13px; border-radius: 999px; font-family: var(--f-disp); font-size: 16px; color: var(--mute); }
.tab[aria-selected="true"] { color: var(--ink); border-color: rgba(63, 224, 216, .5); background: rgba(63, 224, 216, .12); }
.chip { flex: none; border: 1px solid var(--line); background: transparent; padding: 5px 11px; border-radius: 999px; font-size: 13px; color: var(--mute); }
.chip[aria-pressed="true"] { color: var(--abyss); background: var(--amber); border-color: var(--amber); }
.lede { margin: 2px 20px 8px; color: var(--mute); font-size: 13px; max-width: 60ch; }
.lede b { color: var(--ink); font-weight: 500; }
.scroll { position: relative; flex: 1; overflow-y: auto; padding: 4px 16px 24px 20px; -webkit-overflow-scrolling: touch; }
.sec { margin: 14px 0 8px; font-family: var(--f-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--teal); }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 10px; }
.grid.wide { grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
.card { display: flex; flex-direction: column; gap: 6px; min-width: 0; text-align: left; padding: 8px 8px 10px; border-radius: var(--r);
  border: 1px solid var(--line); background: rgba(10, 26, 50, .55); transition: border-color .2s, background .2s; }
.card:hover { border-color: rgba(125, 227, 238, .4); background: rgba(14, 34, 62, .7); }
.card canvas { width: 100%; aspect-ratio: 1.2; display: block; border-radius: 6px;
  background: radial-gradient(90% 90% at 50% 40%, #0d2442, #050c1a); image-rendering: pixelated; }
.grid.wide .card canvas { aspect-ratio: 2.1; }
.grid.sq .card canvas { aspect-ratio: 1; }
.card .nm { font-size: 13px; font-weight: 500; line-height: 1.25; overflow-wrap: break-word; hyphens: auto; -webkit-hyphens: auto; }
.card .mt { font-family: var(--f-mono); font-size: 11px; color: var(--mute); overflow-wrap: anywhere; }
.big { width: 100%; display: block; border-radius: 8px; image-rendering: pixelated; background: radial-gradient(90% 90% at 50% 40%, #0d2442, #050c1a); }

/* detail sheet inside the catalogue */
.detail { position: absolute; inset: 0; display: flex; flex-direction: column; background: var(--abyss);
  padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
.detail .body { flex: 1; overflow-y: auto; padding: 4px 16px 24px 20px; display: flex; flex-direction: column; gap: 12px; }
.detail h3 { margin: 0; font-family: var(--f-disp); font-weight: 400; font-size: 22px; flex: 1; min-width: 0; }
.detail p { margin: 0; color: #b9cfdc; max-width: 62ch; }
.kv { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; font-size: 13px; }
.kv dt { color: var(--mute); }
.kv dd { margin: 0; font-family: var(--f-mono); font-size: 12px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.seg { display: flex; flex-wrap: wrap; gap: 6px; }

/* inspector bar */
.insp { position: fixed; z-index: 15; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: 8px;
  padding: 14px max(18px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 16px) max(18px, env(safe-area-inset-left, 0px));
  background: linear-gradient(0deg, rgba(4, 10, 22, .96) 30%, rgba(4, 10, 22, 0)); }
.insp .top { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.insp h3 { margin: 0; font-family: var(--f-disp); font-weight: 400; font-size: clamp(22px, 4vw, 32px); flex: 1 1 260px; min-width: 0; text-wrap: balance; }
.insp p { margin: 0; color: #b9cfdc; max-width: 70ch; font-size: 14px; }
.insp .meta { font-family: var(--f-mono); font-size: 12px; color: var(--mute); overflow-wrap: anywhere; }
.insp .meta b { color: var(--amber); font-weight: 500; }

.toast { position: fixed; z-index: 60; left: 50%; top: calc(env(safe-area-inset-top, 0px) + 78px); transform: translate(-50%, -12px); opacity: 0;
  padding: 9px 16px; border-radius: 999px; background: var(--glass-hi); border: 1px solid var(--line); font-size: 14px; pointer-events: none;
  transition: opacity .3s, transform .3s; max-width: calc(100vw - 32px); text-align: center; }
.toast.show { opacity: 1; transform: translate(-50%, 0); }

@media (max-width: 640px) {
  .cat { width: 100vw; border-left: 0; }
  .hud .counts { font-size: 13px; }
  .btn { padding: 9px 14px; font-size: 14px; }
  .grid { grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
  .grid.wide { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }

</style>
</head>
<body>
<canvas id="gl" tabindex="0" aria-label="Подводный город — живая 3D-сцена из моделей пака"></canvas>

<div class="loader" id="loader" lang="ru">
  <h2>Затонувший город</h2>
  <div class="ld-bar"><i id="ldFill"></i></div>
  <div id="ldText">Поднимаем город со дна…</div>
</div>

<header class="hud" id="hud" lang="ru">
  <p class="eyebrow">ассет-пак · тайл 16×16 · 1 блок = 16 вокселей</p>
  <h1>Затонувший город</h1>
  <p class="counts" id="counts">Готический город на дне: светящийся мох, рыбы с огнями, затонувшие корабли, батискафы.</p>
</header>

<nav class="dock" id="dock" aria-label="Режимы" lang="ru">
  <button class="btn primary" id="bCat" type="button">Каталог пака</button>
  <button class="btn" id="bPilot" type="button">Сесть в батискаф</button>
</nav>

<div class="pick" id="pick" lang="ru" hidden>
  <div style="display:flex;flex-direction:column;min-width:0"><b id="pickName"></b><span id="pickMeta"></span></div>
  <button id="pickOpen" type="button">Смотреть в 3D</button>
</div>

<div id="pilot" lang="ru" hidden>
  <p id="pHint"></p>
  <button class="btn" id="pExit" type="button">Выйти</button>
  <p id="danger">Удильщик рядом</p>
  <div id="joy"><i></i></div>
  <div class="row">
    <div class="col">
      <button class="round" id="pUp" type="button" aria-label="Всплыть">▲</button>
      <button class="round" id="pDown" type="button" aria-label="Погрузиться">▼</button>
    </div>
    <button class="round big" id="pSonar" type="button">Сонар</button>
  </div>
</div>

<aside class="cat off" id="cat" aria-label="Каталог пака" lang="ru" hidden>
  <header><h2>Каталог</h2><button class="x" id="catClose" type="button" aria-label="Закрыть каталог">✕</button></header>
  <div class="tabs" id="tabs" role="tablist"></div>
  <div class="chips" id="chips"></div>
  <p class="lede" id="lede"></p>
  <div class="scroll" id="catScroll"></div>
  <div class="detail" id="detail" hidden>
    <header><h3 id="dTitle"></h3><button class="x" id="dClose" type="button" aria-label="Назад к каталогу">✕</button></header>
    <div class="body" id="dBody"></div>
  </div>
</aside>

<section class="insp" id="insp" lang="ru" hidden aria-live="polite">
  <div class="top">
    <button class="btn" id="iBack" type="button">← Каталог</button>
    <h3 id="iName"></h3>
  </div>
  <p id="iDesc"></p>
  <div class="meta" id="iMeta"></div>
  <div class="seg" id="iClips"></div>
</section>


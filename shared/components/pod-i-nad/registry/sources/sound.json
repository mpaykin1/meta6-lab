      "id": "pod-i-nad/registry/sound/thunder",
      "source": "defineSound('thunder', (k) => [\n  ['hiss', 0.22, 2600, 0.7, 0.04 + 0.12 * k, 'bandpass', 0],                 // the crack — loud only when close\n  ['hiss', 2.8, 150, 0.5, 0.1 + 0.28 * k, 'lowpass', 0.06 + (1 - k) * 0.9],  // the roll arrives later from afar\n  ['tone', 44, 2.4, 'sine', 0.05 + 0.14 * k, 28, 0.08 + (1 - k) * 0.9],\n])",
      "source_line_start": 1336,
      "source_line_end": 1340
    },

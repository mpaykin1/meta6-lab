    const s=Nit.read().luchnik, p={yarus_max:Math.max(s.yarus_max,G.depth||0),luk:SAVE.weapon};
    if(event==='hit') p.perya=s.perya+1;
    if(event==='win') p.pobedy=s.pobedy+1;
    if(event==='loss') p.porazheniya=s.porazheniya+1;
    Nit.write('luchnik',p); if(event==='win'||event==='loss')z23Fog.history(Nit.read().luchnik);
  } catch {}
}

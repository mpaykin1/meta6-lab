-8,0)},{name:"Виадуки 2D",desc:"Дальний плоский слой силуэтов виадуков с огоньками окон, кольцом вокруг мира.",r:95,look:new V3(0,0,0)},{name:"Грозовое небо",desc:"Тучи из 2.5D-карточек, ветвистые молнии, вспышки подсвечивают облака и постройки.",r:55,look:new V3(0,10,0)},{name:"Огненный шар",desc:"Воксельное пламя с ореолом и искрами. Попадание стрелой взрывает его в воздухе.",r:16,look:new V3(0,0,0)},{name:"Взрыв виадука",desc:"Шар дальнего дракона разносит пролёт виадука в щепки.",r:160,look:new V3(0,-8,0)},{name:"Добыча",desc:"Из дракона летят монетки, сердца (новая жизнь) и ледяные стрелы.",r:9,look:new V3(0,0,0)},{name:"Кассетный шар",desc:"Багровый шар на полпути распадается на несколько огненных шаров.",r:22,look:new V3(0,0,0)}];let gi=0,gItems=[];const gRoot=new Group;gScene.add(gRoot);function galBuild(r){if(gItems[r])return gItems[r];let e={};if(r==0){const t=new Dragon(gScene);e={d:t,upd:(i,a)=>{const s=new V3(Math.sin(a*.5)*6,Math.sin(a*.9)*1.2,Math.cos(a*.5)*6);t.steer(s,6,1.5,i),t.animate(i,a,camera.position,.2),GAL[0].look.copy(t.root.position)},show:i=>t.setVisible(i)}}if(r==1){const t=new Group,i=new Archer(t),a=new Tower(t,77,0,-.5,0,2,"plain");gRoot.add(t),e={g:t,upd:(s,l)=>{i.update(s,l,new V3(Math.sin(l*.6),Math.sin(l*.8)*.4+.2,Math.cos(l*.6)).normalize()),Math.sin(l*2.1)>.97&&i.shootT<=0&&i.shoot(),a.update(l)}}}if(r>=2&&r<=4){const t=new Group,i=new Tower(t,[13,29,47][r-2]*101,0,0,0,14,["plain","bridge","ruin"][r-2]);gRoot.add(t),e={g:t,upd:(a,s)=>i.update(s)}}if(r==5){const t=new Group,i=new BoxGeometry(1.4,1.4,1.4),a=new Float32Array(8),s=new Float32Array(8),l=new InstancedMesh(i,blockMat,8);for(let o=0;o<8;o++)a[o]=o,s[o]=o==4?3:o,_m4.makeTranslation((o%4-1.5)*2.1,(o<4?1:-1)*1.1,0),l.setMatrixAt(o,_m4),l.setColorAt(o,_c.setScalar(1));i.setAttribute("aSide",new InstancedBufferAttribute(a,1)),i.setAttribute("aTop",new InstancedBufferAttribute(s,1)),l.computeBoundingSphere(),t.add(l),gRoot.add(t),e={g:t,upd:(o,c)=>{t.rotation.y=Math.sin(c*.4)
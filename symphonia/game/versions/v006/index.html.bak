const PX=.87,PZ=-2.65;let outline=[[-.9,.69],[.9,.69],[.93,.12],[.78,-.48],[.44,-1.27],[.06,-1.47],[-.40,-1.35],[-.77,-.94],[-.90,-.35]];function pianoShape(y,c){for(let i=0;i<outline.length;i++){let a=outline[i],b=outline[(i+1)%outline.length];tri([PX,y,PZ],[PX+a[0],y,PZ+a[1]],[PX+b[0],y,PZ+b[1]],c)}}for(let i=0;i<outline.length;i++){let a=outline[i],b=outline[(i+1)%outline.length];quad([PX+a[0],.84,PZ+a[1]],[PX+b[0],.84,PZ+b[1]],[PX+b[0],1.15,PZ+b[1]],[PX+a[0],1.15,PZ+a[1]],tint(piano,.9+.09*Math.cos(i)));rod([PX+a[0],1.17,PZ+a[1]],[PX+b[0],1.17,PZ+b[1]],.018,gold)}target=slices;for(let y=.86;y<1.17;y+=.025)pianoShape(y,tint(piano,.97));target=solid;pianoShape(1.18,piano);for(let [x,z] of [[-.73,.49],[.73,.49],[.0,-1.16]]){cyl(PX+x,0,PZ+z,.82,.055,.088,piano,12);cyl(PX+x,.09,PZ+z,.07,.09,.09,gold,12)}box(PX,.77,PZ+.78,1.79,.15,.36,piano);for(let i=0;i<33;i++){let x=PX-.78+i*.047;box(x,.919,PZ+.78,.043,.025,.25,ivory);if(i%7!==2&&i%7!==6)box(x+.026,.946,PZ+.72,.025,.025,.13,piano)}box(PX,.48,PZ+1.27,.83,.11,.42,piano);for(let x of [-.32,.32])for(let z of [-.15,.15])cyl(PX+x,0,PZ+1.27+z,.48,.043,.052,piano,12);


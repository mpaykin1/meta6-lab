function table(x,z){box(x,.91,z,1.32,.12,.74,stone);for(let a of [-1,1])for(let b of [-1,1]){let X=x+a*.51,Z=z+b*.26,p=[];for(let k=0;k<=15;k++){let t=k/15;p.push([X+a*.12*Math.sin(t*TAU),t*.94,Z+b*.04*Math.sin(t*PI)])}path(p,.045,gold)}box(x,.80,z,1.23,.10,.67,gold);stack(x,.95,z,.09,.38,roundUV,.03)}function chair(x,z){box(x,.47,z,.57,.11,.54,stone);for(let a of [-1,1])for(let b of [-1,1])rod([x+a*.27,.0,z+b*.25],[x+a*.22,.49,z+b*.21],.031,gold);for(let a of [-1,1])rod([x+a*.26,.53,z-.24],[x+a*.28,1.14,z-.24],.035,gold);arc(x,1.08,z-.24,.29,.26,0,PI,'xy',.04,gold);box(x,.62,z-.24,.45,.49,.045,ivory)}for(let z of [1,-9,-18]){table(5.6,z);chair(-5.55,z)}
